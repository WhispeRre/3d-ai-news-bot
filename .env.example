# 复制为 .env 并填入真实值（.env 不会被提交）。GitHub Actions 里对应配置成仓库 Secrets。

# AI 整理：Cursor Dashboard → Integrations 生成
CURSOR_API_KEY=

# 飞书群自定义机器人（config.json 里 feishu.mode = webhook 时）：群设置 → 群机器人 → 添加机器人 → 自定义机器人
FEISHU_WEBHOOK_URL=
# 机器人开启了"签名校验"时填写
FEISHU_WEBHOOK_SECRET=
# 可选：采集或推送失败时的告警群（建议单独建一个只有自己的群）。应用机器人方式下告警优先私信，私信失败才发这里
FEISHU_ALERT_WEBHOOK_URL=
FEISHU_ALERT_WEBHOOK_SECRET=

# 飞书应用机器人（config.json 里 feishu.mode = app 时）：开发者后台 → 凭证与基础信息
LARK_APP_ID=
LARK_APP_SECRET=

# 可选：X 信源（twitterapi.io）。配好后把 config.json 里 twitter 信源的 enabled 改成 true
TWITTERAPI_IO_KEY=

# 可选：本地运行用的 GitHub token；不填会自动借用 gh CLI 的登录态
GITHUB_TOKEN=

# Cloudflare Worker（trigger-worker/）准点触发工作流用的 GitHub token：fine-grained，仅本仓库、Actions 读写。
# 部署时写进 Worker 的密钥，不用配到 GitHub Secrets
GH_DISPATCH_TOKEN=
